# Slim multi-stage API image for Docker Compose / EC2 (no LaTeX; PDFs via pdf-service).
# Set DATABASE_URL (and other secrets) via `.env.prod` or your host/orchestrator env.

# Stage 1: Build dependencies
FROM python:3.11-slim-bookworm AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Runtime image
FROM python:3.11-slim-bookworm

WORKDIR /app

# Copy Python packages from builder
COPY --from=builder /root/.local /root/.local

# Make sure scripts in .local are usable
ENV PATH=/root/.local/bin:$PATH

# Runtime OS deps: Playwright/Chromium libs for job URL parsing.
# LaTeX/Poppler are intentionally excluded; PDF generation runs in a separate service.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Playwright browsers (Chromium only, minimal deps)
# Note: This is required for JS-rendered job postings
RUN playwright install --with-deps chromium \
    && rm -rf /root/.cache/ms-playwright/webkit* \
    && rm -rf /root/.cache/ms-playwright/firefox*

# Copy application code
COPY . .

EXPOSE 8000

RUN chmod +x scripts/entrypoint.sh

CMD ["/bin/sh", "scripts/entrypoint.sh"]
