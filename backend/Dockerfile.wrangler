# Optimized multi-stage build for Cloudflare Containers
# Reduces image size and improves push reliability
#
# DATABASE_URL must be set for the process (Worker forwards vars + secrets). Use Neon Postgres
# in production (psycopg2-binary in requirements.txt); push DATABASE_URL with cloudflare/backend-api `npm run secrets:push`.

# Stage 1: Build dependencies
FROM python:3.11-slim-bookworm AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Runtime image
FROM python:3.11-slim-bookworm

WORKDIR /app

# Copy Python packages from builder
COPY --from=builder /root/.local /root/.local

# Make sure scripts in .local are usable
ENV PATH=/root/.local/bin:$PATH

# Runtime OS deps: Playwright/Chromium libs for job URL parsing.
# LaTeX/Poppler are intentionally excluded; PDF generation runs in a separate service.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Playwright browsers (Chromium only, minimal deps)
# Note: This is required for JS-rendered job postings
RUN playwright install --with-deps chromium \
    && rm -rf /root/.cache/ms-playwright/webkit* \
    && rm -rf /root/.cache/ms-playwright/firefox*

# Copy application code
COPY . .

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
