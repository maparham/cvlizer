# Database Configuration
DATABASE_URL=sqlite:///./cv_optimizer.db

# Database Connection Pool Configuration
# These settings control database connection pooling for PostgreSQL/MySQL
# (SQLite uses StaticPool automatically - these settings don't apply)
# Development defaults: 5+5 connections (single developer)
# Override these for production or testing environments
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# JWT Configuration (Legacy - kept for backward compatibility)
JWT_SECRET_KEY=your-secret-key-here-change-in-production-12345678901234567890
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Impersonation Configuration
IMPERSONATION_ENABLED=true
IMPERSONATION_TTL_SECONDS=1800
IMPERSONATION_RATE_LIMIT_ADMIN_PER_HOUR=10
IMPERSONATION_RATE_LIMIT_TARGET_PER_DAY=5
IMPERSONATION_COOKIE_SECURE=false
IMPERSONATION_STRICT_IP_BINDING=false
DATA_RETENTION_DAYS_SESSIONS=90
DATA_RETENTION_DAYS_AUDIT=365
CLEANUP_INTERVAL_MINUTES=60

# Clerk Configuration
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key-here
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key-here

# Clerk JWT Verification (Required for production)
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_AUDIENCE=your-clerk-frontend-api-id

# Development Mode Settings
DEV_MODE=false
CLERK_VERIFY_TOKENS=true

# Admin Configuration
ADMIN_EMAIL=your-admin-email@example.com

# AI Provider (OPTIONAL - defaults to "openai")
# Set to "openrouter" to use OpenRouter instead of OpenAI.
# When using OpenRouter: set OPENROUTER_API_KEY and OPENROUTER_MODEL.
# Dashboard prompt IDs (OPENAI_CV_QUALITY_*) are OpenAI-only; use presets for OpenRouter.
AI_PROVIDER=openai

# OpenAI Configuration (REQUIRED when AI_PROVIDER=openai)
# Never hardcode model names - always read from .env
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-5-nano

# OpenAI Parsing Model (REQUIRED - for CV and job description parsing)
# This model is used specifically for parsing CVs and extracting job descriptions
# Can use a different model than OPENAI_MODEL to optimize cost/performance
OPENAI_PARSING_MODEL=gpt-5-nano

# OpenAI Parsing Effort (OPTIONAL - defaults to "minimal")
# Controls reasoning effort for CV and job description parsing operations
# Options: "minimal" (fastest, cheapest - recommended for parsing),
#          "low" (faster, cheaper),
#          "medium" (balanced quality and cost),
#          "high" (better quality, slower, more expensive)
OPENAI_PARSING_EFFORT=minimal

# OpenAI CV Quality: optional dashboard prompt IDs (OPTIONAL - leave empty for inline prompts)
# When set, CV quality uses OpenAI dashboard prompts by ID. Fallback: CV_QUALITY_PROMPT_ID etc.
# Proofread mode: OPENAI_CV_QUALITY_PROMPT_ID; coach mode: OPENAI_CV_QUALITY_COACH_PROMPT_ID.
# Prompt must include placeholder named CV_QUALITY_PROMPT_CV_VARIABLE (e.g. {{cv_data}}).
# OPENAI_CV_QUALITY_PROMPT_ID=
# OPENAI_CV_QUALITY_COACH_PROMPT_ID=
# OPENAI_CV_QUALITY_PROMPT_VERSION=
# OPENAI_CV_QUALITY_COACH_PROMPT_VERSION=

# AI Reasoning Effort (OPTIONAL - defaults to "medium")
# Controls quality/cost/speed trade-off for general AI operations (non-parsing)
# Options: "low" (faster, cheaper, may take shortcuts),
#          "medium" (balanced - recommended),
#          "high" (better quality, slower, more expensive)
AI_REASONING_EFFORT=medium

# AI Reasoning Summary (OPTIONAL - defaults to "auto")
# Controls how much reasoning trace is included in OpenAI Responses API output.
# Options: "auto", "concise", "detailed"
AI_REASONING_SUMMARY=auto

# CV Quality Analysis Verbosity (OPTIONAL - defaults to "low")
# Controls text verbosity for CV quality analysis responses
# Options: "low" (concise feedback - recommended),
#          "medium" (balanced detail),
#          "high" (detailed feedback)
# Default coaching rewording when the client omits rewording_mode: minimal | deep
# CV_QUALITY_DEFAULT_REWORDING_MODE=minimal

CV_QUALITY_VERBOSITY=low

# CV Quality Reasoning Effort (OPTIONAL - defaults to "minimal")
# For OpenRouter/reasoning models: reduces reasoning tokens to leave room for JSON output
# Options: "minimal", "low", "medium", "high"
CV_QUALITY_REASONING_EFFORT=minimal

# CV Quality Max Draft History (OPTIONAL - defaults to 3)
# Max number of previous generations to keep per field (retry history). Users can navigate
# back/forward through these with left/right arrows. Range: 1–10.
# CV_QUALITY_MAX_DRAFT_HISTORY=3

# CV Quality prompt placeholder (shared; used with OpenAI dashboard prompts)
# CV_QUALITY_PROMPT_CV_VARIABLE=cv_data

# Agent Model Configuration (REQUIRED - for job description parsing)
# This model is used exclusively for job description URL parsing
AGENT_MODEL=gpt-5-nano

# Agent Processing Tier (OPTIONAL - no default; omit to not send to API)
# When set: "flex" (cost-optimized) or "standard" (faster). Uncomment and set as needed:
# AGENT_PROCESSING_TIER=standard

# OpenRouter Configuration (OPTIONAL - only when AI_PROVIDER=openrouter)
# Get an API key at https://openrouter.ai. Model can be a full id (e.g. openai/gpt-4o-mini)
# or a preset (e.g. @preset/coaching-prompt); with presets only the user message is sent.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_PARSING_MODEL=openai/gpt-4o-mini

# OpenRouter presets (optional): when set, that operation uses the preset instead of inline prompts.
# Create presets in the OpenRouter dashboard; the app sends only the user message (system prompt from preset).
# Leave empty to use OPENROUTER_MODEL/OPENROUTER_PARSING_MODEL + inline prompts.
# CV Quality: proofread vs coach modes. Fallback: OPENROUTER_CV_QUALITY_PRESET for both.
# OPENROUTER_CV_QUALITY_PROOFREAD_PRESET=@preset/proofread-prompt
# OPENROUTER_CV_QUALITY_COACH_PRESET=@preset/coaching-prompt
# OPENROUTER_CV_QUALITY_PRESET=@preset/cv-quality
# OPENROUTER_PARSING_PRESET=
# OPENROUTER_JOB_EXTRACTION_PRESET=
# OPENROUTER_SECTION_GENERATION_PRESET=
# OPENROUTER_AI_SUGGESTIONS_PRESET=

# OpenRouter app attribution (optional): app name and URL for openrouter.ai rankings/analytics
# OPENROUTER_APP_TITLE=cvlator
# OPENROUTER_REFERER=https://your-app-domain.com

# AI Timeout (OPTIONAL - defaults to 60 seconds)
# Controls the timeout for AI API requests in seconds
# Increase for longer operations (e.g., 900 for 15 minutes)
AI_TIMEOUT=60

# Quick Start CV Parsing Timeout (OPTIONAL - defaults to 30 seconds)
# Max time allowed for CV parsing in the quick start preview (anonymous upload)
# Increase if large or complex PDFs often hit the timeout
# QUICK_START_CV_TIMEOUT=60

# Browser Automation Configuration
# Selenium browser automation is used for JavaScript-heavy job sites
# No additional configuration required - runs locally without API keys
# Chrome browser must be installed on the system

# Application Configuration
DEBUG=true
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# CORS Configuration (comma-separated; main.py reads CORS_ALLOW_ORIGINS)
# Include every SPA origin (https://app.example.com and https://example.com count as two origins).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_ENABLED=false
LOG_FILE=app.log

# Frontend Environment Variables
# These should be set in your frontend .env.local file

# Feature Flags
# Set to 'true' to show the CV history sidebar panel (default is hidden due to bugs)
VITE_SHOW_HISTORY_PANEL=false

# Rate Limiting Configuration
# Note: Rate limiting is always enabled

# AI Parsing Rate Limits (CV parsing, JD parsing from URLs)
# Format: "number/period" where period can be: second, minute, hour, day
# Multipliers supported: "10/15minutes" means 10 requests per 15 minutes
AI_PARSING_RATE_LIMIT=10/15minutes

# AI Reasoning Rate Limits (content enhancement, ATS optimization, suggestions, job fit analysis)
AI_REASONING_RATE_LIMIT=5/15minutes

# Admin API Testing Rate Limit
ADMIN_RATE_LIMIT=10/minute
