# Database Configuration
DATABASE_URL=sqlite:///./cv_optimizer.db

# JWT Configuration (Legacy - kept for backward compatibility)
JWT_SECRET_KEY=your-secret-key-here-change-in-production-12345678901234567890
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Impersonation Configuration
IMPERSONATION_SECRET_KEY=your-impersonation-secret-key-here-change-in-production-12345678901234567890
IMPERSONATION_TOKEN_EXPIRE_MINUTES=30

# Clerk Configuration
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key-here
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key-here

# Admin Configuration
ADMIN_EMAIL=your-admin-email@example.com

# OpenAI Configuration
OPENAI_API_KEY=your-openai-key-here

# Application Configuration
DEBUG=true
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Configuration
LOG_LEVEL=INFO
