{
  // Worker entry + Container from ../../backend/Dockerfile.wrangler (slim; use Dockerfile for full TeX).
  // Plain-text backend env (Worker `vars`): `npx wrangler deploy`. Do not put secrets here.
  // Secrets (JWT, Clerk, OpenAI, DATABASE_URL for Neon Postgres, etc.): `npm run secrets:push`
  // from repo root `.env.prod`, or `npx wrangler secret put NAME` / `wrangler secret bulk file.env`
  // (see scripts/push-worker-secrets.mjs). Do not put DATABASE_URL in `vars` — use secrets only.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cv-lator-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "vars": {
    "JWT_ALGORITHM": "HS256",
    "JWT_ACCESS_TOKEN_EXPIRE_MINUTES": "15",
    "JWT_REFRESH_TOKEN_EXPIRE_DAYS": "7",
    "CLERK_JWKS_URL": "https://clerk.rahkar.pro/.well-known/jwks.json",
    "CLERK_ISSUER": "https://clerk.rahkar.pro",
    "CLERK_AUDIENCE": "clerk.enabling-chamois-1",
    "CLERK_VERIFY_TOKENS": "true",
    "PUBLIC_FRONTEND_BASE_URL": "https://rahkar.pro",
    "ADMIN_EMAIL": "mahmoud.shahrud@gmail.com",
    "AI_PROVIDER": "openai",
    "OPENAI_MODEL": "gpt-5.4",
    "OPENAI_PARSING_MODEL": "gpt-5.4",
    "OPENAI_PARSING_EFFORT": "low",
    "CV_QUALITY_PROMPT_CV_VARIABLE": "cv_data",
    "OPENROUTER_MODEL": "openai/gpt-5.2",
    "OPENROUTER_PARSING_MODEL": "openai/gpt-5-mini",
    "OPENROUTER_APP_TITLE": "cvlator",
    "AI_REASONING_EFFORT": "low",
    "AI_REASONING_SUMMARY": "concise",
    "CV_QUALITY_VERBOSITY": "low",
    "CV_QUALITY_REASONING_EFFORT": "minimal",
    "CV_QUALITY_HTML_DIFF_MAX_LENGTH": "10000",
    "CV_QUALITY_MAX_DRAFT_HISTORY": "5",
    "AGENT_PROCESSING_TIER": "flex",
    "AI_PARSING_RATE_LIMIT": "10/15minutes",
    "AI_REASONING_RATE_LIMIT": "3/15minutes",
    "AI_TIMEOUT": "180",
    "AI_MAX_COMPLETION_TOKENS": "4000",
    "AI_CV_PARSING_MAX_COMPLETION_TOKENS": "4000",
    "QUICK_START_CV_TIMEOUT": "120",
    "QUICK_START_JOB_TIMEOUT": "120",
    "FREE_TIER_COST_PER_30_DAYS": "0.25",
    "FREE_TIER_DISPLAY_TOKEN_CAP": "50000",
    "FREE_TIER_QUOTA_ENABLED": "true",
    "DEBUG": "false",
    "DEV_MODE": "false",
    "CORS_ALLOW_ORIGINS": "https://cvlator.rahkar.pro,https://rahkar.pro,http://localhost,https://localhost,http://127.0.0.1",
    "MAX_FILE_SIZE": "10485760",
    "ALLOWED_FILE_TYPES": "application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    "PROFILE_PICTURE_MAX_SIZE": "1048576",
    "LOG_LEVEL": "INFO",
    "IMPERSONATION_ENABLED": "true",
    "IMPERSONATION_TTL_SECONDS": "1800",
    "IMPERSONATION_RATE_LIMIT_ADMIN_PER_HOUR": "20",
    "IMPERSONATION_RATE_LIMIT_TARGET_PER_DAY": "50",
    "IMPERSONATION_STRICT_IP_BINDING": "false",
    "DATA_RETENTION_DAYS_SESSIONS": "90",
    "DATA_RETENTION_DAYS_AUDIT": "365",
    "CLEANUP_INTERVAL_MINUTES": "60",
    "DB_POOL_SIZE": "5",
    "DB_MAX_OVERFLOW": "5",
    "DB_POOL_TIMEOUT": "30",
    "DB_POOL_RECYCLE": "3600",
    "ENABLE_CV_HISTORY": "false"
  },
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "BackendContainer",
      "image": "../../backend/Dockerfile.wrangler",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND_CONTAINER",
        "class_name": "BackendContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BackendContainer"]
    }
  ]
}
