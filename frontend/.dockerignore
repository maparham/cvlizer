# Dependencies (reinstalled in image via npm ci)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output (rebuilt in image)
dist
build
.next
out

# Git and IDE
.git
.gitignore
.cursor
.vscode
*.swp
*.swo
.DS_Store

# Env and secrets (injected at build/run, not baked in)
.env
.env.*
!.env.example

# Tests and coverage (not needed for production build)
coverage
.nyc_output
__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
tests
test-files
jest.config.*
setupTests.ts
**/__mocks__

# Docs and misc
README*
*.md
.editorconfig
.prettierrc*
.eslintrc*
