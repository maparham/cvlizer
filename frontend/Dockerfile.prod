# Multi-stage build for production
# Node 18 does not provide the Web API `File` global, which newer undici-based
# dependencies can rely on at build time (e.g. via @cloudflare/vite-plugin).
# Use Node 20+ so Vite config loads consistently in Docker.
FROM node:20-alpine AS builder

WORKDIR /app
COPY package*.json ./
# Full install so devDependencies (vite, rollup) and rollup's optional native binary are available for the build
RUN npm ci

COPY . .
# Prod: use relative /api (same origin) so admin and other API requests hit backend via nginx /api/ proxy
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
# Clerk key must be set at build time (Vite inlines VITE_* env into the bundle)
ARG VITE_CLERK_PUBLISHABLE_KEY=
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY
# Admin email for showing Admin dashboard (must match backend ADMIN_EMAIL)
ARG VITE_ADMIN_EMAIL=
ENV VITE_ADMIN_EMAIL=$VITE_ADMIN_EMAIL
# Public URL for Open Graph / SEO (og:url); set per deployment when building for another domain
ARG VITE_PUBLIC_URL=
ENV VITE_PUBLIC_URL=$VITE_PUBLIC_URL
# Use build:no-ts so prod image builds even when tsc has errors; type-check separately with npm run type-check
# Node heap 2 GB; fits within limited Docker memory (e.g. 2.5 GB)
ENV NODE_OPTIONS="--max-old-space-size=2048"
RUN npm run build:no-ts

# Production stage
FROM nginx:alpine

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration (frontend/nginx.conf already enables gzip in the server block)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
