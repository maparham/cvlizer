# Multi-stage build for production
FROM node:18-alpine AS builder

WORKDIR /app
COPY package*.json ./
# Full install so devDependencies (vite, rollup) and rollup's optional native binary are available for the build
RUN npm ci

COPY . .
# Prod: use relative /api (same origin). Dev sets VITE_API_BASE_URL=http://localhost:8000 in .env.local
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
# Use build:no-ts so prod image builds even when tsc has errors; type-check separately with npm run type-check
RUN npm run build:no-ts

# Production stage
FROM nginx:alpine

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration (frontend/nginx.conf already enables gzip in the server block)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
