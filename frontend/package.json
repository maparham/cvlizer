{
  "name": "cv-optimizer-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:prod": "vite build --mode production",
    "build:no-ts": "vite build --mode production",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:slow": "PLAYWRIGHT_LAUNCH_OPTIONS='{\"slowMo\":600}' playwright test --headed",
    "test:e2e:very-slow": "PLAYWRIGHT_LAUNCH_OPTIONS='{\"slowMo\":1000}' playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.48.1",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@formkit/auto-animate": "^0.9.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@internationalized/date": "^3.9.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@mui/x-date-pickers": "^8.11.2",
    "@react-aria/datepicker": "^3.15.1",
    "@react-stately/datepicker": "^3.15.1",
    "@uiw/react-md-editor": "^3.25.0",
    "axios": "^1.6.2",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.18",
    "framer-motion": "^12.23.13",
    "jsondiffpatch": "^0.7.3",
    "react": "^18.2.0",
    "react-aria": "^3.43.2",
    "react-diff-viewer-continued": "^3.4.0",
    "react-dom": "^18.2.0",
    "react-flip-move": "^3.0.5",
    "react-input-mask": "^2.0.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.20.1",
    "react-stately": "^3.41.0",
    "recharts": "^2.15.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tanstack/react-query": "^5.87.4",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.8",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-input-mask": "^3.0.6",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "terser": "^5.44.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
